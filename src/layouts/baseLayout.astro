---
const { title, description, ogImage, canonicalUrl } = Astro.props;
import { SITE_NAME } from "@/config";
import "../styles/global.css";
import "../styles/globalPageTransition.css";
import InfoModal from "@/components/infoModal.astro";
import Analytics from '@vercel/analytics/astro'

const metaTitle = title ? `${SITE_NAME.siteNameFull} | ${title}` : SITE_NAME.siteNameFull;
const metaDescription = description ?? "A CSS-first component library for modern UI interactions.";
const metaImage = ogImage ?? "https://toggle.supply/assets/og-image/togglesupply-OGImage.webp";
const metaUrl = canonicalUrl ?? "https://toggle.supply";
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/svg/togglesupply-favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet" />
    <link rel="canonical" href={metaUrl} />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={metaUrl} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE_NAME.siteNameFull} />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@togglesupply" />
    <meta name="twitter:url" content={metaUrl} />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaImage} />
  </head>
  <body>
    <a href="#main-content" class="skip-to-main">Skip to main content</a>
    <Analytics/>

    <InfoModal>
      <slot name="infoModal" />
    </InfoModal>

    <main id="main-content" class="page-content">
      <slot />
    </main>

  </body>
</html>