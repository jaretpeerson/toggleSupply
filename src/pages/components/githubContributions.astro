---
import BaseLayout from "../../layouts/baseLayout.astro";
import NavMain from "@/components/navMain.astro";
import "../../styles/components/githubContributions.css";
---

<script type="module" src="/scripts/components/githubContributions.js"></script>

<BaseLayout title="GitHub Contributions Animation" description="Placeholder">
    <NavMain
    title="GitHub Contributions Animation"
    navCenterText="GitHub Contributions Animation"
    htmlLinkHref="https://github.com/jaretpeerson/toggleSupply/blob/main/src/pages/components/githubContributions.astro"
    cssLinkHref="https://github.com/jaretpeerson/toggleSupply/blob/main/src/styles/components/githubContributions.css"
    javascriptLinkHref="https://github.com/jaretpeerson/toggleSupply/blob/main/public/scripts/components/githubContributions.js" />

    <div class="github-graph-track">
        <div class="github-graph-section">
            <div class="github-graph-wrapper">
                <div class="github-graph-months">
                    <span>APR</span>
                    <span>MAY</span>
                    <span>JUN</span>
                    <span>JUL</span>
                    <span>AUG</span>
                    <span>SEP</span>
                    <span>OCT</span>
                    <span>NOV</span>
                    <span>DEC</span>
                    <span>JAN</span>
                    <span>FEB</span>
                    <span>MAR</span>
                </div>
                <div class="github-graph-grid"></div>
            </div>
        </div>
    </div>

</BaseLayout>