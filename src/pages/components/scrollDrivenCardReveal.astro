---
import BaseLayout from "../../layouts/baseLayout.astro";
import NavMain from "@/components/navMain.astro";
import "../../styles/components/scrollDrivenCardReveal.css";
---

<script type="module" src="/scripts/components/scrollDrivenCardReveal.js"></script>

<BaseLayout title="Scroll Progress" description="PLACEHOLDER">
<NavMain
    atitle="Scroll Progress"
    navCenterText="Scroll Progress"
    htmlLinkHref="https://github.com/jaretpeerson/toggleSupply/blob/main/src/pages/components/scrollDrivenCardReveal.astro"
    cssLinkHref="https://github.com/jaretpeerson/toggleSupply/blob/main/src/styles/components/scrollDrivenCardReveal.css"
    javascriptLinkHref="https://github.com/jaretpeerson/toggleSupply/blob/main/public/scripts/components/scrollDrivenCardReveal.js" />

    <div class="scroll-media-track">
        <div class="scroll-media-section">
            <div class="scroll-media-wrapper">
                <div class="scroll-media-card" data-index="1" data-string="scroll">
                    <img src="/assets/images/image-135.webp" alt="">
                </div>
                <div class="scroll-media-card" data-index="2" data-string="scroll">
                    <img src="/assets/images/image-113.webp" alt="">
                </div>
                <div class="scroll-media-card" data-index="3" data-string="scroll">
                    <img src="/assets/images/image-138.webp" alt="">
                </div>
                <div class="scroll-media-card" data-index="4" data-string="scroll">
                    <img src="/assets/images/image-93.webp" alt="">
                </div>
                <div class="scroll-media-card" data-index="5" data-string="scroll">
                    <img src="/assets/images/image-50.webp" alt="">
                </div>
            </div>
        </div>
    </div>


</BaseLayout>