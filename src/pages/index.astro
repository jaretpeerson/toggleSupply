---
import { NAV_LINKS } from "@/config";
import BaseLayout from "../layouts/baseLayout.astro";
import ContentGrid from "@/components/contentGrid.astro";
import NavMain from "@/components/navMain.astro";
import FooterMain from "@/components/footerMain.astro";
import "../styles/index.css";
---

<BaseLayout title="Home" description="A growing collection of hand-coded UI components, animations, and interactions for modern web development.">
    
    <NavMain 
    inspirationLinkHref={NAV_LINKS.inspiration}
    buttonsLinkHref=""
    githubLinkHref={NAV_LINKS.github}
    linkedinLinkHref={NAV_LINKS.linkedinCompany}
    instagramLinkHref={NAV_LINKS.instagram}
    emailLinkHref={NAV_LINKS.email}
    navCenterText="" />

    <div class="container">
        <section class="intro-text">
        <h1>A growing collection of hand-coded components for modern web development.</h1>
    </section>

    <ContentGrid
        dataFile="/data/content-components.json" />
    </div>

    <FooterMain></FooterMain>

</BaseLayout>